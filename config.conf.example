# Echo AI Configuration
# =====================
#
# Format: key = value
# Sections: [section] for nesting (accessed as section.key)
# Comments start with #
# No quotes needed — values are trimmed

[agent]
# LLM provider (default: ollama)
provider = ollama

# Model name to use (required)
model = gemma2:2b

# System prompt for the agent
# system_prompt = You are a helpful AI assistant.

# Temperature: 0-100 (divided by 100 for LLM, e.g. 70 = 0.7, default: 70)
# temperature = 70

# Request timeout in seconds (default: 120)
# timeout = 120

# Maximum LLM iterations per user message (default: 50)
# max_iterations = 50

# Max messages to keep in context (default: 50)
# max_context_messages = 50

# Max characters to keep in context (default: 100000)
# max_context_chars = 100000

[ollama]
# Base URL of the Ollama server (default: http://localhost:11434)
# base_url = http://localhost:11434

# Context window size for the model (default: 4096)
# num_ctx = 4096

# How long to keep the model loaded in seconds (default: 120)
# keep_alive_secs = 120

[safety]
# Restrict file operations to this directory (default: current dir)
# workspace = ./

# Allow network access for web_fetch and web_search (default: true)
# allow_network = true

# Maximum file size in bytes for read/write (default: 10485760 = 10 MB)
# max_file_size = 10485760

# Maximum execution time for bash commands in seconds (default: 300)
# max_execution_time = 300

[session]
# Enable encrypted session persistence via SQLite (default: false)
# Requires ECHO_PASSWORD env var or ~/.config/echo-ai/password file
# enabled = true

[search]
# Search provider for web_search tool: brave, duckduckgo, or tavily
# provider = brave

# API key for Brave or Tavily (not needed for DuckDuckGo)
# api_key = your-api-key-here

[server]
# HTTP server port (default: 8080)
# port = 8080
