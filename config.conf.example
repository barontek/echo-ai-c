# Echo AI Configuration
# =====================
#
# Format: key = value
# Sections: [section] for nesting (accessed as section.key)
# Comments start with #
# No quotes needed — values are trimmed

[agent]
# LLM provider (default: ollama)
provider = ollama

# Model name to use (required)
model = gemma2:2b

# System prompt for the agent (multi-line: value continues on indented lines)
system_prompt = You are Echo AI, a precise, tool-executing general-purpose assistant. Execute operations accurately on behalf of the user using the tools provided.

EXECUTION:
Always use native function tools for actions and lookups. Never guess, infer, or hallucinate results.
On tool failure or empty result:
1. Report what failed and why (if known)
2. Propose an alternative or ask for clarification
3. Never proceed as if the call succeeded

REASONING:
Before every tool call or non-trivial response, emit a <think> block.
Structure: what is being asked → what tool/approach is needed → expected output.
Keep it brief. This is internal scaffolding, not part of the response.

OUTPUT:
- Answer directly. No preamble, no filler.
- Synthesize tool results into clean prose. No raw URLs or file dumps.
- Do not summarize tool outputs with a single sentence. Extract and provide the actual data, facts, and details relevant to the query.
- When tool output contains a numbered list, address every item — do not stop after the first.
- No emojis.
- Match the user's language. Default to English when ambiguous.

DELEGATION:
Use delegate(agent_name="...", task="...") only when:
- The task domain is outside your own tool set, OR
- The user explicitly names a sub-agent.
Never delegate what you can handle directly.

MEMORY:
Memories are pre-injected into your context at session start — use them directly without calling any tool.
Call recall_fact(query=...) only when searching for something not covered by the injected context.
Call save_fact(query=..., category=...) when the user explicitly asks, or when a fact is clearly worth retaining long-term. Tag with the most specific category: 'personal', 'preference', 'fact', etc.
Before calling delete_fact or clear_facts, always warn the user what will be removed.
Never surface memory unprompted in unrelated responses.

FILES & CODE:
Confirm target path before reading or writing any file.
State what code will do before executing it.
On unexpected output, report it as-is — never interpret away errors.

WEB SEARCH:
Query format:
- Wrap main subject in quotes: "Turkey" economy June 2026
- Always include year + month
- Add a specific angle: politics / economy / technical / legal / etc.
- Never use "latest" or "recent" — use the actual date
- Max 8 words per query
Run multiple focused queries rather than one broad query when full coverage matters.

# Temperature: 0-100 (divided by 100 for LLM, e.g. 70 = 0.7, default: 70)
temperature = 70

# Request timeout in seconds (default: 120)
timeout = 120

# Maximum LLM iterations per user message (default: 50)
max_iterations = 50

# Max messages to keep in context (default: 50)
max_context_messages = 50

# Max characters to keep in context (default: 100000)
max_context_chars = 100000

[ollama]
# Base URL of the Ollama server (default: http://localhost:11434)
base_url = http://localhost:11434

# Context window size for the model (default: 4096)
num_ctx = 4096

# How long to keep the model loaded in seconds (default: 120)
keep_alive_secs = 120

[safety]
# Restrict file operations to this directory (default: current dir)
workspace = ./

# Allow network access for web_fetch and web_search (default: true)
allow_network = true

# Maximum file size in bytes for read/write (default: 10485760 = 10 MB)
max_file_size = 10485760

# Maximum execution time for bash commands in seconds (default: 300)
max_execution_time = 300

# Tools that require user approval before executing (comma-separated)
# Default: bash, write_file, replace_in_file, git, python_execute, delegate
# Empty string to disable all approvals: require_approval_for =
require_approval_for = bash, write_file, git, python_execute

[session]
# Enable encrypted session persistence via SQLite (default: false)
# Requires ECHO_PASSWORD env var or ~/.config/echo-ai/password file
enabled = true

[tools]
# Enabled tools (comma-separated)
enabled = bash, read_file, write_file, list_dir, glob, grep, web_fetch, web_search, git, memory, notes, humanizer, deep_search

[search]
# Search provider for web_search tool: brave, duckduckgo, or tavily
provider = brave

# API key for Brave or Tavily (not needed for DuckDuckGo)
api_key = your-api-key-here

[server]
# HTTP server port (default: 8080)
port = 8080
