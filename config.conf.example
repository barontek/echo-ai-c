# Echo AI Configuration
# =====================
#
# Format: key = value
# Sections: [section] for nesting (accessed as section.key)
# Comments start with #
# No quotes needed — values are trimmed

[agent]
# LLM provider (default: ollama)
provider = ollama

# Model name to use (required)
model = gemma2:2b

# System prompt for the agent (multi-line: value continues on indented lines)
system_prompt = You are Echo AI, a precise, tool-executing general-purpose assistant. Execute operations accurately on behalf of the user using the tools provided.

EXECUTION:
Always use native function tools for actions and lookups. Never guess, infer, or hallucinate results.
On tool failure or empty result:
1. Report what failed and why (if known)
2. Propose an alternative or ask for clarification
3. Never proceed as if the call succeeded

REASONING:
Before every tool call or non-trivial response, emit a <think> block.
Structure: what is being asked → what tool/approach is needed → expected output.
Keep it brief. This is internal scaffolding, not part of the response.

OUTPUT:
- Answer directly. No preamble, no filler.
- Synthesize tool results into clean prose. No raw URLs or file dumps.
- Do not summarize tool outputs with a single sentence. Extract and provide the actual data, facts, and details relevant to the query.
- When tool output contains a numbered list, address every item — do not stop after the first.
- No emojis.
- Match the user's language. Default to English when ambiguous.

DELEGATION:
Use delegate(agent_name="...", task="...") only when:
- The task domain is outside your own tool set, OR
- The user explicitly names a sub-agent.
Never delegate what you can handle directly.

MEMORY:
Memories are pre-injected into your context at session start — use them directly without calling any tool.
Call recall_fact(query=...) only when searching for something not covered by the injected context.
Call save_fact(query=..., category=...) when the user explicitly asks, or when a fact is clearly worth retaining long-term. Tag with the most specific category: 'personal', 'preference', 'fact', etc.
Before calling delete_fact or clear_facts, always warn the user what will be removed.
Never surface memory unprompted in unrelated responses.

FILES & CODE:
Confirm target path before reading or writing any file.
State what code will do before executing it.
On unexpected output, report it as-is — never interpret away errors.

WEB SEARCH:
Query format:
- Wrap main subject in quotes: "Turkey" economy June 2026
- Always include year + month
- Add a specific angle: politics / economy / technical / legal / etc.
- Never use "latest" or "recent" — use the actual date
- Max 8 words per query
Run multiple focused queries rather than one broad query when full coverage matters.

# Temperature: 0-100 (divided by 100 for LLM, e.g. 70 = 0.7, default: 70)
temperature = 70

# Request timeout in seconds (default: 120)
timeout = 120

# Reasoning effort for providers that support it (openai, openai_compatible,
# ollama, opencode_zen). Accepted values are provider-specific: openai
# accepts low/medium/high/xhigh/max/none; the others accept
# low/medium/high/max/none (no xhigh). Unset/empty = provider default.
effort = medium

# Maximum LLM iterations per user message (default: 50)
max_iterations = 50

# Max messages to keep in context (default: 50)
max_context_messages = 50

# Max characters to keep in context (default: 100000)
max_context_chars = 100000

# Cap on a single tool result before it enters the context; oversized
# results are truncated with an "[... truncated ...]" marker (default: 25000)
max_tool_result_chars = 25000

[ollama]
# Base URL of the Ollama server (default: http://localhost:11434)
base_url = http://localhost:11434

# Context window size for the model (default: 4096)
num_ctx = 4096

# How long to keep the model loaded in seconds (default: 120)
keep_alive_secs = 120

[openai]
# ChatGPT Plus/Pro OAuth provider. Sign in from the web UI by selecting
# OpenAI in the provider menu. API keys are not accepted for this provider.

[openai_compatible]
# OpenAI-compatible endpoint (LM Studio, vLLM, llama.cpp server, ...).
# Set agent.provider = openai_compatible to use it. A token is optional
# and read from the [providers] section if present.
base_url = http://localhost:1234

[opencode_zen]
# OpenCode Zen: OpenAI-compatible gateway at opencode.ai (curated models,
# pay-per-use, a few free ones). Set agent.provider = opencode_zen to use it.
# Requires the shared "opencode" token in the [providers] section (see below),
# issued at https://opencode.ai/auth; otherwise the service rejects with 401.
base_url = https://opencode.ai/zen/v1

[opencode_go]
# OpenCode Go: OpenAI-compatible gateway at opencode.ai (models served
# through the Go tier, e.g. deepseek-v4-flash). Set
# agent.provider = opencode_go to use it. Shares the "opencode" token
# with opencode_zen.
base_url = https://opencode.ai/zen/go/v1

[safety]
# Policy strictness dial:
#   restricted  - policy checks + require_approval_for list (default)
#   approve_all - policy checks stay on, but EVERY tool call asks the user
#   unrestricted - all policy checks and approvals off (paths, commands,
#                  URLs, sockets, workspace pinning). Resource guards stay:
#                  bash timeouts, size caps, result truncation, audit log.
# mode = restricted

# Restrict file operations to this directory (default: current dir)
workspace = ./

# Allow network access for web_fetch and web_search (default: true)
allow_network = true

# Maximum file size in bytes for read/write (default: 10485760 = 10 MB)
max_file_size = 10485760

# Maximum characters of fetched page text passed to the LLM. web_fetch
# strips HTML boilerplate and truncates to this budget (default: 25000)
web_fetch_max_chars = 25000

# Maximum execution time for bash commands in seconds (default: 300)
max_execution_time = 300

# File extensions that are never readable/writable (comma-separated).
# Setting this REPLACES the built-in defaults (.key, .pem, .env, .token,
# .password, .aws, .netrc, .htpasswd, .crt, .p12) — e.g. use
# blocked_extensions = .exe, .dll to allow .env files in this repo.
# Default (unset): the built-in list above.
# blocked_extensions = .exe

# Paths/substrings that are never readable/writable (comma-separated).
# Setting this REPLACES the built-in defaults (/etc/passwd, /etc/shadow,
# /etc/sudoers, .git/config). The workspace pinning
# (safety_resolve_path_alloc) still blocks everything outside the
# workspace regardless of this list.
# blocked_paths = secret_dir

# Tools that require user approval before executing (comma-separated)
# Default: bash, write_file, edit, git, python_execute, delegate
# Empty string to disable all approvals: require_approval_for =
require_approval_for = bash, write_file, git, python_execute

# How long the Web UI waits for the user to answer an agent's ask_user
# question before the tool gives up with "(user did not respond)"
# (seconds, default: 60)
ask_user_timeout = 60

[session]
# Enable encrypted session persistence via SQLite (default: false)
enabled = true

[tools]
# Enabled tools (comma-separated)
enabled = bash, read_file, write_file, list_dir, glob, grep, web_fetch, web_search, git, memory, notes, humanizer, deep_search, browser

# browser tool: opens a real, visible browser window on the desktop.
# The binary is auto-discovered; override with env vars:
#   ECHO_BROWSER_BIN          explicit path or binary name
#   ECHO_BROWSER_HEADLESS=1   run without a window
#   ECHO_BROWSER_USER_DATA_DIR  persistent profile (default: temp, removed on close)
#   ECHO_BROWSER_FLAGS        extra args, e.g. "--no-sandbox --window-size=1440,900"

[search]
# Search provider for web_search tool: brave, duckduckgo, or tavily
provider = brave

# API key for Brave or Tavily (not needed for DuckDuckGo)
api_key = your-api-key-here

[providers]
# API tokens for OpenAI-compatible LLM providers that need authentication.
# Format: provider_name = token
# The token is sent as a Bearer Authorization header by compatible clients.
# The openai provider is OAuth-only and must not be configured here.
# opencode = your-opencode-key  (shared by opencode_zen and opencode_go)
# anthropic = your-anthropic-api-key

[server]
# HTTP server port (default: 8080)
port = 8080
# Bind address (default: 0.0.0.0 — all interfaces). Set to 127.0.0.1 when
# running behind the TLS proxy (make run-tls) so the plaintext port is not
# exposed on the network.
# bind = 127.0.0.1

[tui]
# Terminal UI appearance (used by --cli mode)
# style = dark | light | highcontrast | none (plain monochrome)
style = dark
# density = compact | spacious
density = compact
# accent = RRGGBB hex (optional; overrides the preset accent)
# accent = 7aa2f7
# transparent = true — leave the terminal background unpainted so a
# transparent/blurred terminal (e.g. kitty) shows through. The status
# bar, error highlights, and modal backdrop stay opaque.
# transparent = false
